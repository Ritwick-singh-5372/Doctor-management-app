# Local development database started with docker compose up -d db.
# Override the development password before deploying anywhere.
POSTGRES_PASSWORD=careflow_dev
DATABASE_URL=postgresql+psycopg://careflow:careflow_dev@127.0.0.1:5432/careflow
# Next.js server forwards /api/* to Flask; no browser CORS setup is needed.
API_URL=http://127.0.0.1:5000
